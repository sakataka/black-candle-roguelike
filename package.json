{
  "name": "black-candle-roguelike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --hot scripts/dev-frontend.ts",
    "build": "bun run typecheck && bun run scripts/build-frontend.ts",
    "test": "bun test",
    "simulate:ai": "bun run src/game/sim/headless.ts",
    "simulate:batch": "bun run src/game/sim/batch.ts",
    "typecheck": "bun check --threads=4"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "pixi.js": "^8.22.0",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
