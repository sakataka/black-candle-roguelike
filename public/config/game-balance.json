      "tactic.early-care": {
        "label": "早めの手当て",
        "description": "回復薬を少し早めに使い、深手を負う前に立て直す。薬の回復量+40%。",
        "add": { "healBonus": 0.05 },
        "perks": { "healPercent": 40 }
