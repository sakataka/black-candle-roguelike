      "tactic.archer-hunt": { "label": "射手狩り", "description": "遠隔の敵を最優先で追い詰め、投げ針も射手へ向ける。", "set": { "rangedPriority": true, "chaseRanged": true } },
      "tactic.cover-dance": {
        "locked": true,
        "label": "遮蔽を渡る",
        "description": "盾を掲げ、壁や遮蔽の陰を伝って射手へ詰め寄る。遠隔防御+2。",
        "set": { "coverApproach": true, "chaseRanged": true },
        "perks": { "rangedDefense": 2 }
      },
      "tactic.straight-path": { "label": "最短路", "description": "寄り道をせず、階段が見えたらすぐ降りる。", "set": { "discoveryDetour": false, "exploreBeforeStairs": 0 } },
      "tactic.thorough": {
        "locked": true,
        "label": "隅々まで",
        "description": "階の七割を探索し、遺物と碑文を調べてから降りる。",
        "set": { "discoveryDetour": true, "exploreBeforeStairs": 0.7 }
      },
      "tactic.duelist": {
        "locked": true,
        "label": "果敢に挑む",
        "description": "手負いでも敵と守り手へ斬り込み、経験を稼ぐ。",
        "add": { "combatHp": -0.12, "bossEngageHp": -0.12 },
        "set": { "huntWeakEnemies": true }
      },
      "tactic.trap-reader": {
        "locked": true,
        "label": "罠を読む",
        "description": "運命の標に手を出さず、既知の罠は長く行き詰まるまで踏まない。罠回避+15%。",
        "set": { "avoidRiskPanels": true, "trapPatience": 45 },
        "perks": { "trapAvoidPercent": 15 }
      },
      "tactic.dart-volley": {
        "locked": true,
        "label": "投げ針を惜しまない",
        "description": "燠火の投げ針を5本余分に携え、見えた敵へ遠くからでも放つ。",
        "add": { "dartMinHp": -0.2, "dartRange": 2 },
        "grantItems": [{ "contentId": "item.ember-dart", "quantity": 5 }]
